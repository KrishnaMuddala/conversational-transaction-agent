###############################################################################
# CVM instance with Docker bootstrap
###############################################################################

locals {
  # The .env file content that the CVM will write to disk at first boot.
  # All secrets are injected from Terraform variables, so nothing is hardcoded.
  env_file_content = <<-ENV
    # === DCTA production environment ===
    # Generated by Terraform at $(date)

    # FastAPI
    DEBUG=false
    CORS_ORIGINS=https://${tencentcloud_eip.main.public_ip}

    # Tencent Cloud credentials (CAM)
    TENCENT_SECRET_ID=${var.secret_id}
    TENCENT_SECRET_KEY=${var.secret_key}
    TENCENT_REGION=${var.region}

    # Parser — ADP
    USE_MOCK_PARSER=false
    ADP_APP_KEY=${var.adp_app_key}
    ADP_BASE_URL=${var.adp_base_url}
    ADP_VISITOR_ID=dcta-parser
    ADP_TIMEOUT_SECONDS=60

    # TRTC ASR
    TRTC_SDK_APP_ID=${var.trtc_sdk_app_id}
    TRTC_SDK_SECRET_KEY=${var.trtc_sdk_secret_key}
    TRTC_ASR_ENDPOINT=https://asr-intl.cloud-rtc.com/v3/transcribe
    ASR_ENGINE=16k_en

    # TTS
    TTS_VOICE_TYPE=101001
    TTS_PRIMARY_LANGUAGE=2
    TTS_VOLUME=0
    TTS_SPEED=0

    # Crypto / Gateway
    KMS_KEY_ID=${tencentcloud_kms_key.verify.id}
    KMS_KEY_ALGORITHM=RSA_PKCS1_SHA_256
    SIGNATURE_TTL_SECONDS=60

    # Database
    DATABASE_URL=${local.database_url}

    # COS
    COS_BUCKET=${var.project_name}-audit-${var.app_id}
    COS_REGION=${var.region}

    # DBS Payment API
    DBS_PAYMENT_API_URL=${var.dbs_payment_api_url}
    DBS_PAYMENT_API_KEY=${var.dbs_payment_api_key}

    # Risk
    HIGH_VALUE_THRESHOLD=${var.high_value_threshold}
  ENV

  # Docker Compose override — inside the CVM, the backend reaches the DB via
  # its private IP (TDSQL-C), not the Compose service name.
  compose_override = <<-COMPOSE
    services:
      backend:
        environment:
          - DATABASE_URL=${local.database_url}
          - DEBUG=false
          - USE_MOCK_PARSER=false
        restart: unless-stopped
      frontend:
        restart: unless-stopped
      nginx:
        restart: unless-stopped
        ports:
          - "80:80"
          - "443:443"
        volumes:
          - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
          - /etc/ssl/certs/dcta-selfsigned.crt:/etc/ssl/certs/dcta-selfsigned.crt:ro
          - /etc/ssl/private/dcta-selfsigned.key:/etc/ssl/private/dcta-selfsigned.key:ro
      # No internal Postgres — we use TDSQL-C
  COMPOSE

  user_data = <<-USERDATA
#!/bin/bash
set -euo pipefail

echo "=== DCTA CVM bootstrap starting ==="
exec > >(tee /var/log/dcta-bootstrap.log) 2>&1

# 1. Install Docker
echo ">>> Installing Docker..."
curl -fsSL https://get.docker.com | sh
systemctl enable docker
systemctl start docker
usermod -aG docker ubuntu

# 2. Install Docker Compose plugin
echo ">>> Installing Docker Compose..."
apt-get update -qq
apt-get install -y -qq docker-compose-plugin

# 3. Clone or copy the project
echo ">>> Setting up project..."
mkdir -p /opt/dcta
cd /opt/dcta

# --- If your code is in a Git repo, clone it here ---
# git clone https://github.com/your-org/dcta_tentcent.git .
# --- Otherwise, scp your files to /home/ubuntu/dcta/ then run: ---
# --- find /home/ubuntu/dcta/ -type d -name __pycache__ -exec rm -rf {} +; ---
# --- find /home/ubuntu/dcta/ -name '*.pyc' -delete ---

# 4. Write the .env file
echo ">>> Writing .env..."
cat > backend/.env <<'ENVEOF'
${local.env_file_content}
ENVEOF

# 5. Write the Compose override
echo ">>> Writing docker-compose.override.yml..."
cat > deploy/docker-compose.override.yml <<'COMPOSEEOF'
${local.compose_override}
COMPOSEEOF

# 6. Build and start the stack
echo ">>> Building and starting Docker Compose stack..."
cd /opt/dcta/deploy
docker compose up -d --build

# 7. Wait for backend to be ready
echo ">>> Waiting for backend to be ready..."
for i in $(seq 1 30); do
  if curl -sf http://localhost:80/api/docs > /dev/null 2>&1; then
    echo "Backend is ready!"
    break
  fi
  echo "  attempt $i/30..."
  sleep 5
done

echo "=== DCTA CVM bootstrap complete ==="
echo "App URL: http://$(curl -s http://metadata.tencentyun.com/latest/meta-data/public-keys)"
echo "Check status: docker compose -f /opt/dcta/deploy/docker-compose.yml ps"
USERDATA
}

resource "tencentcloud_instance" "main" {
  instance_name     = "${var.project_name}-cvm"
  availability_zone = var.availability_zone
  image_id          = data.tencentcloud_image.ubuntu.image_id
  instance_type     = var.cvm_instance_type
  vpc_id            = tencentcloud_vpc.main.id
  subnet_id         = tencentcloud_subnet.main.id
  security_groups   = [tencentcloud_security_group.cvm.id]

  system_disk_type = "CLOUD_BSSD"
  system_disk_size = 60

  key_name = tencentcloud_key_pair.main.id

  user_data_raw = local.user_data
  user_data_replace_on_change = true

  # Give the bootstrap script time to finish
  depends_on = [
    tencentcloud_postgresql_instance.main,
    tencentcloud_kms_key.verify,
  ]
}

# ---------------------------------------------------------------------------
# Elastic IP — static public IP for the CVM
# ---------------------------------------------------------------------------
resource "tencentcloud_eip" "main" {
  name                    = "${var.project_name}-eip"
  internet_service_provider = "BGP"
  internet_charge_type     = "TRAFFIC_POSTPAID_BY_HOUR"
}

resource "tencentcloud_eip_association" "main" {
  eip_id      = tencentcloud_eip.main.id
  instance_id = tencentcloud_instance.main.id
}
