# FastAPI
DEBUG=false
CORS_ORIGINS=http://localhost:3010,http://localhost:8080

# Tencent Cloud credentials (use CAM user, not root account)
TENCENT_SECRET_ID=your_cam_secret_id
TENCENT_SECRET_KEY=your_c…_key
TENCENT_REGION=ap-singapore

# Parser — Tencent Cloud Agent Development Platform (ADP)
# 1. Open https://adp.tencentcloud.com and create an application.
# 2. Configure it, test the dialogue, then publish it.
# 3. Publish tab -> Service status. The Experience URL is for humans; the AppKey
#    in the API management table is for software. Click Copy for the full value
#    — the console only ever shows a masked prefix.
#
# ADP_BASE_URL must match the console that issued the AppKey. Host and field
# names have to agree, and a mismatch returns HTTP 200 with SSE code 4505004
# "APPKEY is invalid" — byte-identical to a genuinely bad key, so it is easy to
# misdiagnose. parser.py picks the wire format from this URL.
#
#   international console (adp.tencentcloud.com)
#     https://wss.lke.tencentcloud.com/adp/v2/chat          <- use this
#     https://wss.lke.tencentcloud.com/v1/qbot/chat/sse     fallback, sunsets 2026-12-31
#   China console (adp.cloud.tencent.com)
#     https://wss.lke.cloud.tencent.com/adp/v2/chat
USE_MOCK_PARSER=false
ADP_APP_KEY=your_a…_key
ADP_BASE_URL=https://wss.lke.tencentcloud.com/adp/v2/chat
# ADP_BASE_URL=https://wss.lke.tencentcloud.com/v1/qbot/chat/sse
# ADP_BASE_URL=https://wss.lke.cloud.tencent.com/adp/v2/chat
ADP_VISITOR_ID=dcta-parser
ADP_TIMEOUT_SECONDS=60

# ASR
ASR_ENGINE=16k_en

# TRTC (Tencent Real-Time Communication) — Conversational AI
# Get these from TRTC Console > App Management > your application.
# SDKAppID + SDKSecretKey are used for UserSig generation and TRTC ASR v3 auth.
TRTC_SDK_APP_ID=your_trtc_sdk_app_id
TRTC_SDK_SECRET_KEY=your_tr…_key
TRTC_ASR_ENDPOINT=https://asr-intl.cloud-rtc.com/v3/transcribe

# TTS — voice for clarification prompts and confirmation overlays
# VoiceType 101001 = Zhiyu (female, English-capable). Full list:
# https://cloud.tencent.com/document/product/1073/92668
TTS_VOICE_TYPE=101001
TTS_PRIMARY_LANGUAGE=2
TTS_VOLUME=0
TTS_SPEED=0

# Crypto / Gateway
# KMS_KEY_ID=your-kms-key-id        # verify signatures with Tencent KMS via VerifyByAsymmetricKey
KMS_KEY_ALGORITHM=RSA_PKCS1_SHA_256  # or RSA_PSS_SHA_256, ECC_P256_R1, SM2DSA
SIGNATURE_TTL_SECONDS=60

# Database (TDSQL-C PostgreSQL)
DATABASE_URL=postgresql://postgres:***@db:5432/dbs_dcta

# COS (for audio + audit archive)
COS_BUCKET=
COS_REGION=ap-singapore

# Payment gateway
PAYMENT_API_URL=https://payment-gateway.example.com
PAYMENT_API_KEY=

*** Risk settings
HIGH_VALUE_THRESHOLD=50000
